// Cloudflare Workers static-assets deploy: `npm run build`, then `npx wrangler deploy`.
// Serves the Vite build output; the site is static, so there is no Worker script.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flashpoint",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
